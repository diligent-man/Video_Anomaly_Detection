    "from collections import defaultdict\n",
    "import numpy as np\n",
    "from tqdm import tqdm\n",
    "\n",
    "ds = VideoFolderDataset(r\"D:\\IITB\\IITB-visua\", \"v3\")\n",
    "\n",
    "stats = {\n",
    "    \"total_samples\": 0,\n",
    "    \"class_count\": defaultdict(int),\n",
    "    \"fps_count\": defaultdict(int),\n",
    "    \"resolution\": defaultdict(int),\n",
    "    \"duration\": defaultdict(int)\n",
    "}\n",
    "\n",
    "for i, (stream_info, target) in tqdm(enumerate(ds), total=len(ds), colour=\"red\"):\n",
    "    class_name = ds.classes[target]\n",
    "    fps: None | int = getattr(stream_info, \"frame_rate\", None)\n",
    "    num_frames: None | int = getattr(stream_info, \"num_frames\", None)\n",
    "    resolution: Tuple[int, int] = (getattr(stream_info, \"width\", 0), getattr(stream_info, \"height\", 0))\n",
    "\n",
    "    if fps is not None and num_frames is not None and fps > 0:\n",
    "        length: int = num_frames // fps\n",
    "    else:\n",
    "        length: None = None\n",
    "\n",
    "    metadata: Dict[str, Any] = VideoMetadata(fps, length, resolution).to_dict()\n",
    "    # Cập nhật stats\n",
    "    stats[\"total_samples\"] += 1\n",
    "    stats[\"class_count\"][class_name] += 1\n",
    "    if fps is not None:\n",
    "        stats[\"fps_count\"][fps] += 1\n",
    "    if resolution != (0, 0):\n",
    "        stats[\"resolution\"][resolution] += 1\n",
    "    if length is not None:\n",
    "        stats[\"duration\"][length] += 1\n",
    "\n",
    "print(f\"{{{metadata},{class_name}}}\")\n"
   ]
  },
