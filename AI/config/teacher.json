{
    "global":
    {
//        "save_dir": "/home/trong/Downloads/training_results/",
        "project_name": "AIP391",
//        "experiment_name": "run",
//        "technique": "single",
//        "mode": "train",

        "epochs": 3,
        "print_step": 1,
        "save_step": 1,

        "use_amp": true,
        "use_grad_scaler": true,
        "seed": 12345,
        "device": "cuda",

        "inspect_model_arch": true,
        "inspect_depth": 5,
        "dummy_input_shape": [1, 32, 3, 13, 224, 224],

    },

    "data":
    {
        "train":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "../../dataset/iitb/unlabeled/",
                "loader": "v4",
                "transforms": null,
                "target_transforms": null
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 3,
                "shuffle": false,
                "method": 1,
//                "num_workers": 4,
//                "prefetch_factor": 2,
                "persistent_workers": false
            },
            "forward_strategy": "v1"
        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VADFrameLevelDataset",
                "annotation": "../../dataset/ucf-test/unlabeled/label.csv",
                "loader": "v4",
                "transforms": null,
                "target_transforms": null
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 5,
                "shuffle": true,
                "method": 1,
                "num_workers": 4,
                "prefetch_factor": 2,
                "persistent_workers": false
            },
            "forward_strategy": "v1"
        },
        /////////////////////////////////////////////////////////
        "test": {
            "dataset":{},
            "dataloader":{}
        }
    },

    "architecture":
    {
        "backbone":
        {
//            "name": ["rgb_i3d", "s3d", "clip_vit/b16"],
            "name": ["rgb_i3d"],
            "compile": false,
            "out_proj":
            {
                "hidden_dim": [512, 512],
                "hidden_activation": "ReLU",

                "out_channels": 512,
                "out_activation": null,

                "dropout": 0.5,
                "layer_order": "fc->drop->act"
            }

        },

        "neck":
        {
            "name":"TAN",
            "num_backbones": 1,
            "num_heads": 8,
            "relative_attention": true
        },

        "head":
        {
            "name":"SimpleClassifier",

            "hidden_dim": [512, 32],
            "hidden_activation": "ReLU",

            "out_channels": 1,
            "out_activation": "Sigmoid",

            "dropout": 0.5,
            "layer_order": "fc->drop->act"
        }
//        "postprocessing": {}
    },

    "optim":
    {
        "lr": {"name": "Adam", "lr": 1e-6, "amsgrad": true},
        "scheduler": {"name": "WarmupCosineAnnealingWarmRestarts", "T_0":  7, "num_warmup_steps":  14},
        "regularizer": {}
    },

    "metric":
    {
        "in_train": false,
        "metrics": [
            {"name": "BinaryAUPRC"},
            {"name": "BinaryAUROC"}
        ]
    },

    "loss":
    {
        "name": "MILRankingLoss",
        "margin": 1,
        "sparsity_constraint": true,
        "smoothness_constraint": true,
        "reduction": "mean"
    },

    "checkpoint":
    {
        "load": false,
        "resume_name": "../results",

        "save": false,
        "save_step": true,
        "save_weight_only": true,
        "include_config": true
    },

    "early_stopping":
    {
        "apply": false,
        "patience": 10,
        "min_delta": 0

    },

    "services": [
        {
            "name": "tensorboard",
            "apply": false,
            "inspect_model": true,
            "tracking_metric": ["BinaryAccuracy", "BinaryF1Score"]
        },

        {
            "name": "mlflow",
            "apply": true,
            "tracking_uri": "http://183.80.97.114:5000"
//            "username": "root" ,
//            "password":  "Root123!"
        }
    ]
//    "EVALUATION_STRATEGY": "no"
}
