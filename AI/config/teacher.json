{
    "global":
    {
//        "save_dir": "/home/trong/Downloads/training_results/",
        "project_name": "AIP391",
        "experiment_name": "run",
        "technique": "single",
        "mode": "train",
        "seed": 12345,
        "device": "cuda",
        "epochs": 100,
        "print_batch_step": 1,
        "save_epoch_step": 1,
        "use_amp": true,
        "use_grad_scaler": true
    },

    "data":
    {
        "train":
        {
            "dataset":
            {
                "name": "VideoDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/UCF-Crime/Anomaly_videos/Abuse",
                "ext": "mp4",
                "loader": "v2",
                "device": "cpu",
                "transform": {},
                "return_device": null
            },

            "dataloader":
            {
                "name": "DefaultDataLoader",
                "batch_size": 8,
                "shuffle": true,
                "num_workers": 4,
                "drop_last": false,
                "pin_memory": false,
                "timeout": 10,
                "multiprocessing_context": "fork",
                "prefetch_factor": 2,
                "persistent_workers": false,
                "pin_memory_device": "cuda"
            }

        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VideoDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/UCF-Crime/Anomaly_videos/Abuse",
                "ext": "mp4",
                "loader": "v2",
                "device": "cpu",
                "return_device": null,
                "transform": {}
            },

            "dataloader":
            {
                "name": "DefaultDataLoader",
                "batch_size": 8,
                "shuffle": true,
                "num_workers": 4,
                "drop_last": false,
                "pin_memory": false,
                "timeout": 10,
                "multiprocessing_context": "fork",
                "prefetch_factor": 2,
                "persistent_workers": false,
                "pin_memory_device": "cuda"}
        },
        /////////////////////////////////////////////////////////
        "test": {
            "dataset":{},
            "dataloader":{}
        }
    },

    "architecture":
    {
        "backbone":
        {
//            "name": ["rgb_i3d", "s3d", "clip_vit/b16"],
            "name": ["rgb_i3d"],
            "compile": false,
            "out_proj":
            {
                "hidden_dim": [512, 512],
                "hidden_activation": "ReLU",

                "out_channels": 512,
                "out_activation": null,

                "dropout": 0.5,
                "layer_order": "fc->drop->act"
            }

        },

        "neck":
        {
            "name":"TAN",
            "num_backbones": 1,
            "num_heads": 8,
            "relative_attention": true
        },

        "head":
        {
            "name":"SimpleClassifier",

            "hidden_dim": [512, 32],
            "hidden_activation": "ReLU",

            "out_channels": 1,
            "out_activation": "Sigmoid",

            "dropout": 0.5,
            "layer_order": "fc->drop->act"
        },
//        "postprocessing": {}
    },

    "optim":
    {
        "lr": {"name": "SGD", "lr": 1e-6},
        "scheduler": {},
        "regularizer": {}
    },

    "metric":
    {
        "in_train": true,
        "metrics": [
            {"name": "BinaryAUPRC"},
            {"name": "BinaryAUROC"}
        ]
    },

    "loss":
    {
        "NAME": "BCELoss",
        "ARGS":
        {
            "reduction": "mean"
        }
    },

    "checkpoint":
    {
        "save": false,
        "load": false,
        "save_step": true,
        "save_weight_only": true,
        "include_config": true,
        "resume_name": "../results"
    },

    "services": [
        {
            "name": "tensorboard",
            "apply": true,
            "inspect_model": true,
            "tracking_metric": ["BinaryAccuracy", "BinaryF1Score"]
        }
    ]
//    "EVALUATION_STRATEGY": "no"
}
