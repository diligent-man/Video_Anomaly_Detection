{

    "global":
    {
        "save_dir": "/home/trong/Downloads/Local/Source/Python/semester_9/AIP391/Video_anomaly_detection/AI/results",
        "project_name": "AIP391",
        "experiment_name": "run",
        "technique": "distillation",
        "mode": "train",
        "exist_ok": true,
        "sep": "_",

        "epochs": 1,
        "eval_strategy": "epoch",
        "eval_steps": 3,

        // Resume training
        "resume": false,
        "resume_ckpt": "",

        // GradScaled is automatically init when use_amp=True
        "use_amp": true,
        "seed": 12345,
        "device": "cuda",

        "inspect_model_arch": false,
        "inspect_depth": 7,
        "dummy_input_shape": [1, 32, 3, 13, 224, 224]
    },

    "data":
    {
        "train":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/preprocessing/stage_2/train/IITB/unlabeled",
                "loader": "v4",
                "transform": {
                    "ToDtype": {"dtype": "float32", "scale": true},
//                    "Permute_1": {"dims": [0, 2, 1, 3, 4]},
//                    "ColorJitter": {"brightness":  0.75, "contrast": 0.5, "saturation": 0.5, "hue": 0.25},
//                    "RandomGrayscale": {"p": 0.5},
//                    "GaussianBlur": {"kernel_size": [3, 3], "sigma": [0.5, 2]},
//                    "Permute_2": {"dims": [0, 2, 1, 3, 4]},
                    "RandomResizedCrop_1": {"size": [224, 224], "scale": [0.75, 1], "interpolation":"NEAREST", "antialias": true},
                    "RandomRotation": {"degrees": [-90, 90], "interpolation": "NEAREST", "expand": false}
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": true,
                "method": 1,  // sampled by min datasource
                "num_workers": 4,
                "prefetch_factor": 2,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v2"
        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/preprocessing/stage_2/train/IITB/unlabeled",
                "loader": "v4",
                "transform": {
                    "ToDtype":
                    {
                        "dtype": "float32",
                        "scale": true
                    }
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 1,  // sampled by min datasource
                "num_workers": 3,
                "prefetch_factor": 2,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v2"
        }

        /////////////////////////////////////////////////////////
//        "test": {
//            "dataset":{},
//            "dataloader":{}
//        }
    },

    "architecture":
    {
        "algorithm": "distillation",
        "soft_label_threshold": 0.8,
        "feat_preprocessing": {
            "name": "MLP",

            // Must be compatible with neck's hid_dim output
            "in_channels": 512,

            "hid_dim": [512],
            "hid_act": "ReLU",

            "out_channels": 512,
            "layer_order": "fc->drop->act"
        },

        "models": {
            "student":
            {
                "backbone":
                {
                    "name": ["clip_vit/b16"],
                    "clip_vit/b16_reduce": {"name":  "max_l2"},
                    "compile": true,
                    "out_proj":
                    {
                        "hid_dim": [512],
                        "hid_act": "ReLU",

                        "out_channels": 512,

                        "dropout": 0.5,
                        "layer_order": "fc->drop->act"
                    }
                },

                "neck":
                {
                    "name":"TAN",
                    "num_backbones": 1,
                    "num_heads": 8,
                    "relative_attention": true,
                    "return_neck_out": true
                },

                "head":
                {
                    "name":"SimpleClassifier",

                    "hid_dim": [512, 32],
                    "hid_act": "ReLU",

                    "out_channels": 1,
                    "out_act": null,

                    "dropout": 0.5,
                    "layer_order": "fc->drop->act",
                    "return_logits": true
                }
            },
            "teacher":
            {
                "pretrained": "/home/trong/Downloads/Local/Source/Python/semester_9/AIP391/Video_anomaly_detection/AI/results/AIP391/single/train/input_2d/ckpt/best_epoch9_step2033.pt",
                "backbone":
                {
                    "name": ["clip_vit/b16"],
                    "clip_vit/b16_reduce": {"name":  "max_l2"},
                    "compile": true,
                    "out_proj":
                    {
                        "hid_dim": [512],
                        "hid_act": "ReLU",

                        "out_channels": 512,
                        "out_act": null,

                        "dropout": 0.5,
                        "layer_order": "fc->drop->act"
                    }

                },

                "neck":
                {
                    "name":"TAN",
                    "num_backbones": 1,
                    "num_heads": 8,
                    "relative_attention": true,
                    "return_neck_out": true
                },

                "head":
                {
                    "name":"SimpleClassifier",

                    "hid_dim": [512, 32],
                    "hid_act": "ReLU",

                    "out_channels": 1,
                    "out_act": "Sigmoid",

                    "dropout": 0.5,
                    "layer_order": "fc->drop->act",
                    "return_logits": true
                },

                "postprocessing":
                {
                    "name": "PseudoLabelRefiner",
                    "pad_style": "mean_ema",
                    "kernel_size": 5
                }
            }
        }

    },

    "optim":
    {
        "lr": {"name": "Adam", "lr": 1e-5, "weight_decay": 0.001, "amsgrad": true},
        "scheduler": {"name": "WarmupCosineAnnealingWarmRestarts", "T_0":  13, "num_warmup_steps": 13, "T_mult": 1},
        "regularizer": {}
    },

    "metric":
    {
        "in_train": false,
        "in_val": false,
        "in_test": false,
        "metrics": [
            {"name": "BinaryAUPRC"},
            {"name": "BinaryPrecision"},
            {"name": "BinaryRecall"},
            {"name": "BinaryConfusionMatrix", "normalize": null}
        ]
    },

    "loss":
    {
        "name": "CombinedLoss",
        "loss_config_lst":
        [
            {
                "name": "DistillBCEWithLogitsLoss",
                "reduction": "mean",

                "combined_weight": 1,
                "key": "soft_preds",
                "model_idx_pairs": [[0, 0]]
            }
        ]

    },

    "services": [
        {
            "name": "Checkpointer",
            "apply": true,

            "mode": "min",
            "monitor": "val_loss",
            "save_freq": 1,
            "save_best_only": false,
            "save_weights_only": true,
            "save_total_limit": 3,
            "include_config": true
        },

        {
            "name": "Mlflow",
            "apply": true,
            "push_to_remote": false,
            "prev_run_id": null,
            "init_server_on_run": false,
            "username": "root",
            "password": "Root123!",
            "remote_tracking_uri": "http://42.119.174.56:5000"
        },

        {
            "name": "Earlystopper",
            "mode": "min",
            "monitor": "val_loss",
            "patience": 5,
            "apply": true
        }
    ]
}
