                "name": "VideoDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/UCF-Crime/Anomaly_videos/Abuse",
                "ext": "mp4",
                "loader": "v2",
                "device": "cpu",
                "transform": {},
                "return_device": null
            },

            "DataLoader":
            {
                "name": "DefaultDataLoader",
                "batch_size": 8,
                "shuffle": true,
                "num_workers": 4,
                "drop_last": false,
                "pin_memory": false,
                "timeout": 10,
                "multiprocessing_context": "fork",
                "prefetch_factor": 2,
                "persistent_workers": false,
                "pin_memory_device": "cuda"
            }

        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VideoDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/UCF-Crime/Anomaly_videos/Abuse",
                "ext": "mp4",
                "loader": "v2",
                "device": "cpu",
                "return_device": null,
                "transform": {}
            },

            "DataLoader":
            {
                "name": "DefaultDataLoader",
                "batch_size": 8,
                "shuffle": true,
                "num_workers": 4,
                "drop_last": false,
                "pin_memory": false,
                "timeout": 10,
                "multiprocessing_context": "fork",
                "prefetch_factor": 2,
                "persistent_workers": false,
                "pin_memory_device": "cuda"}
        },
        /////////////////////////////////////////////////////////
        "test": {
            "dataset":{},
            "DataLoader":{}
        }
    },

    "architecture":
    {
        "backbone":
        {
            "name": ["rgb_i3d", "s3d", "clip_vit/b16"],
            "rgb_i3d_args": {"weights": "../weights/I3D/RGB_Kinetics400.pt"},
            "s3d_args": {"weights": "../weights/S3D/RGB_Kinetics400.pth"},
            "clip_vit/b16_args": {"weights": "../weights/CLIP/vit-base-patch16-224/"},
            "compile": false,
            "out_proj":
            {
                "hidden_dim": [512, 512],
                "hidden_activation": "ReLU",

                "out_channels": 512,
                "out_activation": null,

                "dropout": 0.5,
                "layer_order": "fc->drop->act"
            }

        },

        "neck":
        {
            "name":"TAN",
            "num_backbones": 3,
            "num_heads": 8,
            "relative_attention": true
        },

        "head":
        {
            "name":"SimpleClassifier",

            "hidden_dim": [512, 32],
            "hidden_activation": "ReLU",

            "out_channels": 1,
            "out_activation": "Sigmoid",

            "dropout": 0.5,
            "layer_order": "fc->drop->act"
        },
//        "postprocessing": {}
    },

    "optimizer":
    {
        "lr":
        {
            "NAME": "Adam",
            "ARGS":
            {
                "lr": 1e-6,
                "amsgrad": true
            }
        },

        "scheduler":
        {

        },

        "regularizer":
        {

        }
    },

