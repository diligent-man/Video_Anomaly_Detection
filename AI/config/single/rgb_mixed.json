                "name": "DefaultDataLoader",
                "batch_size": 1,
                "shuffle": false,
                "num_workers": 1,
                "prefetch_factor": 1,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v3"
        }
    },

    "architecture":
    {
        "algorithm": "single",
        "backbone":
        {
            "name": ["rgb_i3d", "s3d", "clip_vit/b16"],

            "rgb_i3d_reduce": {"name":  "max_l2"},
            "s3d_reduce": {"name":  "max_l2"},
            "clip_vit/b16_reduce": {"name":  "max_l2"},

            "compile": false,
            "out_proj":
            {
                "hid_dim": [512],
                "hid_act": "ReLU",

                "out_channels": 512,
                "out_act": null,

                "dropout": 0.5,
                "layer_order": "fc->drop->act"
            }
        },

        "neck":
        {
            "name":"TAN",
            "num_backbones": 3,
            "num_heads": 8,
            "relative_attention": true
        },

        "head":
        {
            "name":"SimpleClassifier",

            "hid_dim": [512, 32],
            "hid_act": "ReLU",

            "out_channels": 1,
            "out_act": "Sigmoid",

            "dropout": 0.5,
            "layer_order": "fc->drop->act"
        }
    },

    "optim":
    {
        "lr": {"name": "Adam", "lr": 5e-5, "weight_decay": 1e-5, "amsgrad": true},
        // Warm up 5 epochs
        "scheduler": {"name": "WarmupCosineAnnealingWarmRestarts", "T_0": 226, "num_warmup_steps": 1130, "T_mult": 1},
        "regularizer": {}
    },

    "metric":
    {
        "in_train": false,
        "in_val": false,
        "in_test": true,
        "metrics": [
            {"name": "BinaryAUPRC"},
            {"name": "BinaryAUROC"},
            {"name": "BinaryPrecisionRecallCurve"}
        ]
    },

    "loss":
    {
        "name": "MILRankingLoss",
        "margin": 1,
        "sparsity_constraint": true,
        "smoothness_constraint": true,
        "reduction": "mean"
    },

    "services": [
