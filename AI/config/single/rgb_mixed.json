    "data":
    {
        "train":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/final/train",
                "loader": "v4",
                "transform": {
                    "ToDtype": {"dtype": "float32", "scale": true},
                    "RandomResizedCrop_1": {"size": [224, 224], "scale": [0.75, 1], "interpolation":"NEAREST", "antialias": true},
                    "RandomRotation": {"degrees": [-90, 90], "interpolation": "NEAREST", "expand": false}
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 2,  // sampled by min datasource
                "num_workers": 6,
                "prefetch_factor": 1,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v1"
        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/final/val",
                "loader": "v4",
                "transform": {
                    "ToDtype":
                    {
                        "dtype": "float32",
                        "scale": true
                    }
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 2,  // sampled by min datasource
                "num_workers": 4,
                "prefetch_factor": 1,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v1"
        },
        "test":
        {
            "dataset":
            {
                "name": "VADFrameLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/final/test",
                "annotation": "label.csv",
                "loader": "v4",
                "transform": {
                    "ToDtype":
                    {
                        "dtype": "float32",
