{
    "global":
    {
//        "save_dir": "/home/trong/Downloads/training_results/",
        "project_name": "AIP391",
//        "experiment_name": "run",
//        "technique": "single",
//        "mode": "train",
        "exist_ok": true,
        "sep": "_",

        "epochs": 2,
        "eval_strategy": "epoch",
        "eval_steps": 7,

        "print_step": 1,

        // Resume training
        "resume": false,
        "resume_ckpt": "",

        // GradScaled is automatically init when use_amp=True
        "use_amp": true,
        "seed": 12345,
        "device": "cuda",

        "inspect_model_arch": true,
        "inspect_depth": 3,
        "dummy_input_shape": [1, 32, 3, 30, 224, 224]

    },

    "data":
    {
        "train":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/out/IITB (Copy)/unlabeled",
                "loader": "v4",
                "transform": {
                    "ToDtype":
                    {
                        "dtype": "float32",
                        "scale": true
                    },
//                    "RandomHorizontalFlip": {},
//                    "RandomResizedCrop_1": {"size": [224, 224], "scale": [0.5, 1], "interpolation":"NEAREST", "antialias": true},
//                    "RandomResizedCrop_2": {"size": [224, 224], "scale": [1, 1.5], "interpolation":"BICUBIC", "antialias": true},
//                    "RandomRotation": {"degrees": [-90, 90], "interpolation": "NEAREST", "expand": false},
//                    "Permute_1": {"dims": [0, 2, 1, 3, 4]},
//                    "RandomGrayscale": {"p": 0.5},
//                    "GaussianBlur": {"kernel_size": [3, 3], "sigma": [0.5, 2]},
//                    "Permute_2": {"dims": [0, 2, 1, 3, 4]}
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 1,  // sampled by min datasource
                "num_workers": 4,
                "prefetch_factor": 2,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v1"
        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/out/IITB (Copy)/unlabeled",
                "loader": "v4",
                "transform": {
                    "ToDtype":
                    {
                        "dtype": "float32",
                        "scale": true
                    }
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 1,  // sampled by min datasource
                "num_workers": 3,
                "prefetch_factor": 2,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v1"
        }

        /////////////////////////////////////////////////////////
//        "test": {
//            "dataset":{},
//            "dataloader":{}
//        }
    },

    "architecture":
    {
        "backbone":
        {
//            "name": ["rgb_i3d", "s3d", "clip_vit/b16"],
            "name": ["rgb_i3d", ],
            "compile": false,
            "out_proj":
            {
                "hidden_dim": [512, 512],
                "hidden_activation": "ReLU",

                "out_channels": 512,
                "out_activation": null,

                "dropout": 0.5,
                "layer_order": "fc->drop->act"
            }
        },

        "neck":
        {
            "name":"TAN",
            "num_backbones": 1,
            "num_heads": 8,
            "relative_attention": true
        },

        "head":
        {
            "name":"SimpleClassifier",

            "hidden_dim": [512, 32],
            "hidden_activation": "ReLU",

            "out_channels": 1,
            "out_activation": "Sigmoid",

            "dropout": 0.5,
            "layer_order": "fc->drop->act"
        }

        //        "postprocessing": {}
    },

    "optim":
    {
        "lr": {"name": "Adam", "lr": 1e-6, "amsgrad": true},
        "scheduler": {"name": "WarmupCosineAnnealingWarmRestarts", "T_0":  9, "num_warmup_steps": 9},
        "regularizer": {}
    },

    "metric":
    {
        "in_train": false,
        "in_val": false,
        "in_test": false,
        "metrics": [
            {"name": "BinaryAUPRC"},
            {"name": "BinaryPrecision"},
            {"name": "BinaryRecall"},
            {"name": "BinaryConfusionMatrix", "normalize": null}
        ]
    },

    "loss":
    {
        "name": "MILRankingLoss",
        "margin": 1,
        "sparsity_constraint": true,
        "smoothness_constraint": true,
        "reduction": "mean"
    },

    "early_stopping":
    {
        "apply": false,
        "patience": 10,
        "min_delta": 0

    },

    "services": [
        {
            "name": "Checkpointer",
            "apply": true,

            "mode": "min",
            "monitor": "val_loss",
            "save_freq": 1,
            "save_best_only": false,
            "save_weights_only": true,
            "save_total_limit": 3,
            "include_config": true
        },

        {
            "name": "mlflow",
            "apply": true,
            "tracking_uri": "http://183.80.97.114:5000"
//            "run_id": "800bdcf7ca9b4b2ab51ebd6e243a8757"

//            "username": "root" ,
//            "password":  "Root123!"
        }

//        {
//            "name": "early_stopping",
//            "apply": true
//        }
    ]
//    "EVALUATION_STRATEGY": "no"
}
