{
    "global":
    {
        "save_dir": "/home/trong/Downloads/Local/Source/Python/semester_9/AIP391/Video_anomaly_detection/AI/results",
        "project_name": "AIP391",
        "experiment_name": "input_3d",
        "technique": "single",
        "mode": "train",
        "exist_ok": true,
        "sep": "_",

        "epochs": 15,
        "eval_strategy": "epoch",

        "resume": false,
        "resume_ckpt": null,

        "use_amp": true,
        "seed": 12345,
        "device": "cuda",

        "inspect_model_arch": true,
        "inspect_depth": 7,
        "dummy_input_shape": [1, 32, 3, 30, 224, 224]

    },

    "data":
    {
        "train":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/final/train",
                "loader": "v4",
                "transform": {
                    "ToDtype": {"dtype": "float32", "scale": true},
                    "RandomResizedCrop_1": {"size": [224, 224], "scale": [0.75, 1], "interpolation":"NEAREST", "antialias": true},
                    "RandomRotation": {"degrees": [-90, 90], "interpolation": "NEAREST", "expand": false},
//                    "Permute_1": {"dims": [0, 2, 1, 3, 4]},
//                    "ColorJitter": {"brightness":  0.75, "contrast": 0.5, "saturation": 0.5, "hue": 0.25},
//                    "GaussianBlur": {"kernel_size": [3, 3], "sigma": [0.5, 2]},
//                    "Permute_2": {"dims": [0, 2, 1, 3, 4]}
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 2,  // sampled by min datasource
                "num_workers": 5,
                "prefetch_factor": 2,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v1"
        },
        /////////////////////////////////////////////////////////
        "val":
        {
            "dataset":
            {
                "name": "VADVideoLevelDataset",
                "root": "/home/trong/Downloads/Dataset/VAD/final/val",
                "loader": "v4",
                "transform": {
                    "ToDtype":
                    {
                        "dtype": "float32",
                        "scale": true
                    }
                },
                "target_transform": {}
            },

            "dataloader":
            {
                "name": "VADVideoLevelDataLoader",
                "batch_size": 4,
                "shuffle": false,
                "method": 2,  // sampled by min datasource
                "num_workers": 3,
                "prefetch_factor": 2,
                "persistent_workers": false,
                "multiprocessing_context": "fork"
            },
            "forward_strategy": "v1"
        }
    },

    "architecture":
    {
        "algorithm": "single",
        "backbone":
        {
            "name": ["rgb_i3d", "s3d"],
            "rgb_i3d_reduce": {"name":  "max_l2"},
            "s3d_reduce": {"name":  "max_l2"},

            "compile": true,
            "out_proj":
            {
                "hid_dim": [512],
                "hid_act": "ReLU",

                "out_channels": 512,
                "out_act": null,

                "dropout": 0.5,
                "layer_order": "fc->drop->act"
            }
        },

        "neck":
        {
            "name":"TAN",
            "num_backbones": 2,
            "num_heads": 8,
            "relative_attention": true
        },

        "head":
        {
            "name":"SimpleClassifier",

            "hid_dim": [512, 32],
            "hid_act": "ReLU",

            "out_channels": 1,
            "out_act": "Sigmoid",

            "dropout": 0.5,
            "layer_order": "fc->drop->act"
        }
    },

    "optim":
    {
        "lr": {"name": "Adam", "lr": 1e-5, "weight_decay": 0.00001, "amsgrad": true},
        // Warm up 10% of 50 epochs
        "scheduler": {"name": "WarmupCosineAnnealingWarmRestarts", "T_0": 226, "num_warmup_steps": 1130, "T_mult": 1},
        "regularizer": {}
    },

    "metric":
    {
        "in_train": false,
        "in_val": false,
        "in_test": false,
        "metrics": [
            {"name": "BinaryAUPRC"},
            {"name": "BinaryPrecision"},
            {"name": "BinaryRecall"},
            {"name": "BinaryConfusionMatrix", "normalize": null}
        ]
    },

    "loss":
    {
        "name": "MILRankingLoss",
        "margin": 1,
        "sparsity_constraint": true,
        "smoothness_constraint": true,
        "reduction": "mean"
    },

    "services": [
        {
            "name": "Checkpointer",
            "apply": true,
            "mode": "min",
            "monitor": "val_loss",
            "save_freq": 1,
            "save_best_only": false,
            "save_weights_only": true,
            "save_total_limit": 10,
            "include_config": true
        },

        {
            "name": "Mlflow",
            "apply": true,
            "prev_run_id": null,
            "init_server_on_run": false,
            "username": "",
            "password": "",
            "push_to_remote": false,
            "remote_tracking_uri": ""
        },

        {
            "name": "Earlystopper",
            "mode": "min",
            "monitor": "val_loss",
            "patience": 5,
            "apply": true
        }
    ]
}
