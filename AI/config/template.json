{
    "RUN_NAME": "1",

    "DATA":
    {
        "INPUT_SHAPE": [C, H, W],

        "TRAIN_DATASET_ARGS":
        {
            "extensions": "mp4",
            "root": ""
        },

        "VAL_DATASET_ARGS":
        {
            "extensions": "mp4",
            "root": ""
        },

        "TEST_DATASET_ARGS":
        {
            "extensions": "mp4",
            "root": ""
        },

        "DATALOADER": "DefaultDataLoader",

        "TRAIN_DATALOADER_ARGS":
        {
            "batch_size": 10,
            "shuffle": true,
            "num_workers": 16,
            "prefetch_factor": 4,
            "persistent_workers": true,
            "multiprocessing_context": "spawn"
        },

        "TEST_DATALOADER_ARGS":
        {
            "batch_size": 10,
            "shuffle": true,
            "num_workers": 10,
            "prefetch_factor": 4,
            "persistent_workers": true,
            "multiprocessing_context": "spawn"
        },

        "NUM_CLASSES": 1998,

        "TRANSFORM": {
            "Resize":
            {
                "size": [224, 224],
                "interpolation": "BICUBIC",
                "antialias": true
            },

            "ToDtype":
            {
                "dtype": "float32",
                "scale": true
            }
        },

        "TARGET_TRANSFORM": {}
    },

    "CHECKPOINT":
    {
        "SAVE": true,
        "LOAD": false,
        "SAVE_ALL": false,
        "VERBOSE": true,
        "SAVE_WEIGHT_ONLY": false,
        "INCLUDE_CONFIG": true,
        // RESUME_NAME represents for CHECKPOINT_PATH in Tester() class
        "RESUME_NAME": ""
    },

    "MODEL":
    {
        "ARGS":
        {
            "num_classes": 1998,
            "dropout": 0.5
        }
    },

    "OPTIMIZER":
    {
        "NAME": "Adam",
        "ARGS":
        {
            "lr": 1e-4,
            "weight_decay": 1e-5,
            "amsgrad": true
        }
    },

    "LR_SCHEDULER":
    {
        "APPLY": true,
        "NAME": ["CosineAnnealingWarmRestarts"],
        "ARGS": [{"T_0": 1, "T_mult": 2}]
    },

    "METRIC":
    {
        "IN_TRAIN": false,
        "NAME": [
            "MulticlassAccuracy",
            "MulticlassF1Score"
        ],

        "ARGS": [
            {"num_classes": 1},
            {"num_classes": 1, "average": "weighted"}
        ]
    },

    "LOSS":
    {
        "NAME": "CrossEntropyLoss",
        "ARGS":
        {
            "reduction": "mean"
        }
    },

    "EARLY_STOPPING":
    {
        "APPLY": true,
        "ARGS":
        {
            "patience": 30,
            "min_delta": 0
        }
    },

    "LOGGING":
    {
        "STRATEGY": "epoch"
    },

    "TENSORBOARD": {
        "APPLY": true,
        "INSPECT_MODEL": false,
        "TRACKING_METRIC": [
            "MulticlassAccuracy",
            "MulticlassF1Score"
        ]
    },

    "SLEEP": 0,
    "SEED": 12345,
    "DEVICE": "cuda",
    "TRAINING_EPOCHS": 1
//    "EVALUATION_STRATEGY": "no"

    "TEACHER": {
        "FEATURE_EXTRACTOR":
        [
            {"1": {"num_classes": 1998, "dropout": 0.5}},
            {"2": {"num_classes": 1998, "dropout": 0.5}},
            {"3": {"num_classes": 1998, "dropout": 0.5}}
        ],

        "MLP": {}
    }

}
